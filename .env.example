USE_VAULT=false
DEBUG=true
NAME_SERVICE=equipment-microservice
PORT=50055

DB_HOST=localhost
DB_PORT=5432
DB_NAME=equipment
DB_USER=equipment
DB_PASSWORD=change-me

# External cost system (or the stub: python -m src.cost_system_stub, port 8090)
COST_SYSTEM_URL=http://localhost:8090
COST_SYSTEM_TOKEN=
COST_SYSTEM_TIMEOUT_SECONDS=10

DEFAULT_SHIFT_HOURS=8
SUBMIT_INTERVAL_SECONDS=5
ACCRUAL_INTERVAL_SECONDS=60
WORKER_BATCH_SIZE=50
SUBMIT_MAX_ATTEMPTS=20

# FortMonitor: a Fernet key encrypts the companies' API passwords; empty disables it.
TELEMATICS_ENCRYPTION_KEY=
FORTMONITOR_BASE_URL=https://fort.psmgroup.ru/api/integration/v1/
FORTMONITOR_TIMEOUT_SECONDS=20
# Unit of a track point's dst field: km or m.
FORTMONITOR_TRACK_DISTANCE_UNIT=km

OTEL_HOST=localhost
OTEL_PORT=4318
LOKI_ENDPOINT=
